{
  "name": "lumafx",
  "version": "0.5.0",
  "description": "Premium web effects and animated components from one HTML attribute, plus intelligent UI: blocks an AI writes as JSON (match cards, lineups, standings, charts, tickets, weather…) that render while they stream, on your site or in Claude and ChatGPT through MCP. Framework-agnostic, CSS-first, accessible. Tailwind v4, React Server Components and WordPress. Free forever.",
  "license": "MIT",
  "author": "Arnold Kajolli",
  "type": "module",
  "sideEffects": [
    "*.css",
    "./dist/auto.mjs",
    "./dist/lumafx.global.js",
    "./dist/editor.mjs",
    "./dist/lumafx-editor.global.js",
    "./dist/ui.mjs",
    "./dist/lumafx-ui.global.js"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/lumafx.global.js",
  "jsdelivr": "./dist/lumafx.global.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.mjs"
    },
    "./auto": {
      "types": "./dist/types/auto.d.ts",
      "import": "./dist/auto.mjs"
    },
    "./forms": {
      "types": "./dist/types/forms/core.d.ts",
      "import": "./dist/forms.mjs"
    },
    "./editor": {
      "types": "./dist/types/editor/index.d.ts",
      "import": "./dist/editor.mjs"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react/index.mjs"
    },
    "./ui": {
      "types": "./dist/types/ui/index.d.ts",
      "import": "./dist/ui.mjs"
    },
    "./ui/server": {
      "types": "./dist/types/ui/server.d.ts",
      "import": "./dist/ui-server.mjs"
    },
    "./react/ui": {
      "types": "./dist/types/react/ui.d.ts",
      "import": "./dist/react/ui.mjs"
    },
    "./react/runtime": {
      "types": "./dist/types/react/runtime.d.ts",
      "import": "./dist/react/runtime.mjs"
    },
    "./css": "./dist/lumafx.css",
    "./lumafx.css": "./dist/lumafx.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./transitions.css": "./dist/transitions.css",
    "./effects.json": "./dist/effects.json",
    "./global": "./dist/lumafx.global.js",
    "./editor/global": "./dist/lumafx-editor.global.js",
    "./ui.css": "./dist/lumafx-ui.css",
    "./ui/global": "./dist/lumafx-ui.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/lumafx-wordpress.zip",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "animation",
    "effects",
    "tailwind",
    "tailwindcss",
    "react",
    "nextjs",
    "glassmorphism",
    "liquid-glass",
    "squircle",
    "border-beam",
    "scroll-animation",
    "text-animation",
    "webgl",
    "view-transitions",
    "aos",
    "page-transition",
    "modal",
    "video-scrub",
    "wordpress",
    "components",
    "chat-widget",
    "generative-ui",
    "intelligent-ui",
    "ai",
    "mcp",
    "mcp-apps",
    "football",
    "sports",
    "lineup",
    "tickets"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:tailwind": "node scripts/test-tailwind.mjs",
    "test:browser": "python3 test/browser_test.py",
    "test:all": "npm run build && npm test && npm run test:tailwind && npm run test:browser",
    "test:wordpress": "bash test/wordpress/run.sh"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
